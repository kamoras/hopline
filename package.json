{
  "name": "hopline",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time single pane of glass for public transit: where's my train?",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "a11y": "HOPLINE_DEMO=1 NEXT_PUBLIC_MAP_STYLE_URL=http://localhost:3123/ci-map-style.json next build && HOPLINE_DEMO=1 lhci autorun --config=lighthouserc.json && HOPLINE_DEMO=1 lhci autorun --config=lighthouserc.desktop.json",
    "test:watch": "vitest",
    "data:mnr": "tsx scripts/build-rail-gtfs.ts mnr",
    "data:shoreline-east": "tsx scripts/build-rail-gtfs.ts shoreline-east",
    "data:mbta-subway": "tsx scripts/build-rail-gtfs.ts mbta-subway",
    "data:wmata": "tsx scripts/build-rail-gtfs.ts wmata",
    "data:marc": "tsx scripts/build-rail-gtfs.ts marc",
    "data:vre": "tsx scripts/build-rail-gtfs.ts vre",
    "data:wmata-bus": "tsx scripts/build-rail-gtfs.ts wmata-bus",
    "data:septa-bus": "tsx scripts/build-rail-gtfs.ts septa-bus",
    "data:mbta-bus": "tsx scripts/build-rail-gtfs.ts mbta-bus",
    "data:mbta-cr": "tsx scripts/build-rail-gtfs.ts mbta-cr",
    "data:amtrak": "tsx scripts/build-rail-gtfs.ts amtrak",
    "data:hartford-line": "tsx scripts/build-rail-gtfs.ts hartford-line",
    "data:subway": "tsx scripts/build-subway-gtfs.ts"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "gtfs-realtime-bindings": "^2.2.0",
    "maplibre-gl": "^6.16.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "swr": "^2.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/adm-zip": "^0.6.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "adm-zip": "^0.6.1",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
