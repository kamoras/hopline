# Hopline needs no secrets to run. Everything below is optional.

# Amtraker v3 (community Amtrak tracking API). Override to self-host or mirror.
# AMTRAKER_BASE_URL=https://api.amtraker.com/v3

# Flights: aircraft positions come from adsb.lol (keyless) and airport delays from the FAA (keyless).
# ADSB_API_URL=https://api.adsb.lol/v2
# FAA_STATUS_URL=https://nasstatus.faa.gov/api/airport-status-information

# NYC buses (MTA BusTime) need a free key from https://bustime.mta.info/wiki/Developers/Index. It is used on the server
# only (sent to the MTA as the `key` parameter) and is never sent to the browser or shown on the status page.
# MTA_BUSTIME_KEY=your-key-here
# MTA_BUSTIME_BASE=https://gtfsrt.prod.obanyc.com

# SEPTA (Philadelphia) buses: GTFS-Realtime feeds, keyless.
# SEPTA_GTFSRT_BASE=https://www3.septa.org/gtfsrt/septa-pa-us

# MBTA (Boston) GTFS-Realtime feeds work without a key; a key raises the rate limit and is sent as `x-api-key`.
# MBTA_API_KEY=your-key-here

# MTA GTFS-Realtime feeds for Metro-North. MTA currently serves these without a
# key; if that changes, set the key here and it is sent as `x-api-key`.
# MTA_API_KEY=your-key-here
# MNR_REALTIME_URL=https://api-endpoint.mta.info/Dataservice/mtagtfsfeeds/mnr%2Fgtfs-mnr
# NYCT_FEED_BASE=https://api-endpoint.mta.info/Dataservice/mtagtfsfeeds/   # subway feeds (8) are fetched from here
# MNR_ALERTS_URL=https://api-endpoint.mta.info/Dataservice/mtagtfsfeeds/camsys%2Fmnr-alerts

# WMATA (Washington Metrorail and Metrobus) GTFS and GTFS-Realtime feeds require a free key from https://developer.wmata.com.
# It is read on the server only and sent as the `api_key` header; without it the Washington subway board shows no trains.
# `npm run data:wmata` also reads it when it downloads the static feed.
# WMATA_API_KEY=your-key-here
