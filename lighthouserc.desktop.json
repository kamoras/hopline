{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start -- -p 3123",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3123/",
        "http://localhost:3123/?trip=mnr:1384&board=rail/northeast",
        "http://localhost:3123/?place=subway/nyc/1-av",
        "http://localhost:3123/?place=flights/northeast-air/jfk",
        "http://localhost:3123/?route=bus/boston/1",
        "http://localhost:3123/rail/northeast"
      ],
      "numberOfRuns": 1,
      "settings": {
        "onlyCategories": [
          "accessibility"
        ],
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/desktop"
    }
  }
}
